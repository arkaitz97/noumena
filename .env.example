# =============================================================================
# noumena .env.example
# =============================================================================
# Copy to `.env` and fill in for local development, or use as a reference for
# your production secret manager. Every variable read by `internal/config` is
# listed below in the same order as the `Config` struct (config.go).
#
# Required-vs-optional column meaning:
#   REQUIRED      — config.Load(strict=true) fails without it.
#   REQUIRED IF…  — only validated when the gating flag is true.
#   optional      — has a sensible default; override only when needed.
#
# When you add a new variable to internal/config/config.go, add it here in the
# same PR and update the section header if a new feature group lands.
# =============================================================================


# === DATABASE ================================================================
# Consumed directly by cmd/api/main.go and the operator CLIs (tools/*) — not
# part of the Config struct, but the server will not boot without it.
DATABASE_PATH=./noumena.db                                                     # optional, default ./noumena.db


# === AUTH / JWT ==============================================================
JWT_SECRET=change-me-to-a-32-byte-random-string                              # REQUIRED in strict mode
JWT_ACCESS_TTL=15m                                                            # optional, default 15m
JWT_REFRESH_TTL=720h                                                          # optional, default 720h (30d)
BCRYPT_COST=12                                                                # optional, default 12 (4..31)
EMAIL_VERIFICATION_TTL=24h                                                    # optional, default 24h
PASSWORD_RESET_TTL=1h                                                         # optional, default 1h
APP_BASE_URL=http://localhost:3000                                            # REQUIRED in strict mode (no trailing slash)


# === GOOGLE SSO (sign-in) ====================================================
GOOGLE_SSO_CLIENT_ID=                                                         # REQUIRED in strict mode
GOOGLE_SSO_CLIENT_SECRET=                                                     # REQUIRED in strict mode
GOOGLE_SSO_REDIRECT_URL=http://localhost:8080/auth/google/callback            # REQUIRED in strict mode
GOOGLE_SSO_POPUP_REDIRECT_URL=                                                # optional; SPA popup variant


# === YOUTUBE OAUTH (channel tracking) ========================================
YOUTUBE_OAUTH_CLIENT_ID=                                                      # REQUIRED in strict mode
YOUTUBE_OAUTH_CLIENT_SECRET=                                                  # REQUIRED in strict mode
YOUTUBE_OAUTH_REDIRECT_URL=http://localhost:8080/oauth/youtube/callback       # REQUIRED in strict mode


# === CHANNEL LIFECYCLE =======================================================
CHANNEL_DELETION_GRACE_HOURS=24                                               # optional, default 24
TOKEN_EXPIRY_WARNING_DAYS=7                                                   # optional, default 7
OAUTH_STATE_TTL=10m                                                           # optional, default 10m


# === INGESTION WORKER ========================================================
INGESTION_WORKER_ENABLED=true                                                 # optional, default true
INGESTION_TICK_INTERVAL=30s                                                   # optional, default 30s
INGESTION_POLL_INTERVAL_MINUTES=30                                            # optional, default 30
INGESTION_MAX_RETRIES=5                                                       # optional, default 5
INGESTION_JOB_DEADLINE=5m                                                     # optional, default 5m
INGESTION_MAX_CONCURRENCY=8                                                   # optional, default 8
INGESTION_DEAD_LETTER_ALERT_TO=                                               # optional; comma-separated email list


# === LLM PROCESSING ==========================================================
LLM_PROCESSOR_ENABLED=false                                                   # optional, default false (gated rollout)
LLM_PROCESSOR_TICK_INTERVAL=10s                                               # optional, default 10s
LLM_BATCH_SIZE=50                                                             # optional, default 50
LLM_CONFIDENCE_THRESHOLD=0.7                                                  # optional, default 0.7
LLM_PROCESSOR_SHUTDOWN_GRACE=30s                                              # optional, default 30s

# OpenCode provider credentials — required when LLM_PROCESSOR_ENABLED=true.
OPENCODE_API_KEY=                                                             # REQUIRED IF LLM_PROCESSOR_ENABLED=true
OPENCODE_BASE_URL=https://api.opencode.local/v1                               # optional
OPENCODE_MODEL=opencode/default                                               # optional


# === INSIGHTS API & EXPORTS ==================================================
INSIGHTS_API_ENABLED=false                                                    # optional, default false
EXPORT_DIR=/var/lib/noumena/exports                                           # optional, default /var/lib/noumena/exports
EXPORT_SYNC_THRESHOLD=50000                                                   # optional; rows above this go async
EXPORT_TTL_HOURS=24                                                           # optional, default 24
EXPORT_WORKER_TICK_INTERVAL=5s                                                # optional, default 5s
EXPORT_WORKER_ENABLED=false                                                   # optional, default false
FEED_DEFAULT_LIMIT=20                                                         # optional, default 20
FEED_MAX_LIMIT=100                                                            # optional, default 100
FEED_QUERY_TIMEOUT=2000ms                                                     # optional, default 2s
COUNT_QUERY_TIMEOUT=1500ms                                                    # optional, default 1.5s


# === BILLING (Stripe) ========================================================
# When BILLING_ENABLED=true, every STRIPE_* and BILLING_CHECKOUT_* var below
# is required and Load() will refuse to start without them.
BILLING_ENABLED=false                                                         # optional, default false
STRIPE_SECRET_KEY=sk_test_replace_me                                          # REQUIRED IF BILLING_ENABLED=true
STRIPE_WEBHOOK_SECRET=whsec_replace_me                                        # REQUIRED IF BILLING_ENABLED=true
STRIPE_PRICE_CREATOR_MONTHLY=price_replace_me                                 # REQUIRED IF BILLING_ENABLED=true
STRIPE_PRICE_CREATOR_ANNUAL=price_replace_me                                  # REQUIRED IF BILLING_ENABLED=true
STRIPE_PRICE_STUDIO_MONTHLY=price_replace_me                                  # REQUIRED IF BILLING_ENABLED=true
STRIPE_PRICE_STUDIO_ANNUAL=price_replace_me                                   # REQUIRED IF BILLING_ENABLED=true
STRIPE_PRICE_AGENCY_MONTHLY=price_replace_me                                  # REQUIRED IF BILLING_ENABLED=true
STRIPE_PRICE_AGENCY_ANNUAL=price_replace_me                                   # REQUIRED IF BILLING_ENABLED=true
BILLING_CHECKOUT_SUCCESS_URL=http://localhost:3000/billing/success            # REQUIRED IF BILLING_ENABLED=true
BILLING_CHECKOUT_CANCEL_URL=http://localhost:3000/billing/cancel              # REQUIRED IF BILLING_ENABLED=true


# === TRANSACTIONAL EMAIL =====================================================
# When EMAIL_ENABLED=true, the SMTP_* vars and EMAIL_FROM_ADDRESS are required.
EMAIL_ENABLED=false                                                           # optional, default false
EMAIL_PROVIDER=smtp                                                           # optional, default smtp
EMAIL_FROM_ADDRESS=no-reply@example.com                                       # REQUIRED IF EMAIL_ENABLED=true
EMAIL_FROM_NAME=noumena                                                       # optional
SMTP_HOST=smtp.example.com                                                    # REQUIRED IF EMAIL_ENABLED=true
SMTP_PORT=587                                                                 # optional, default 587
SMTP_USERNAME=                                                                # REQUIRED IF EMAIL_ENABLED=true
SMTP_PASSWORD=                                                                # REQUIRED IF EMAIL_ENABLED=true
APP_SUPPORT_EMAIL=support@example.com                                         # optional; surfaces in some templates


# === LIFECYCLE WORKERS (account deletion + data export) ======================
# When LIFECYCLE_WORKERS_ENABLED=true, EXPORT_STORAGE_DIR + EXPORT_SIGNED_URL_SECRET are required.
LIFECYCLE_WORKERS_ENABLED=false                                               # optional, default false
ACCOUNT_LIFECYCLE_API_ENABLED=false                                           # optional, default false
EXPORT_STORAGE_DIR=/var/lib/noumena/data-exports                              # REQUIRED IF LIFECYCLE_WORKERS_ENABLED=true
EXPORT_SIGNED_URL_SECRET=change-me-to-a-32-byte-random-string                 # REQUIRED IF LIFECYCLE_WORKERS_ENABLED=true
EXPORT_LINK_TTL_DAYS=7                                                        # optional, default 7
DELETION_REVERSIBLE_HOURS=48                                                  # optional, default 48
DELETION_CHUNK_SIZE=10000                                                     # optional, default 10000
EXPORT_PRE_DELETE_TIMEOUT=12h                                                 # optional, default 12h


# === OPENTELEMETRY ===========================================================
# When OTEL_ENABLED=true, OTEL_EXPORTER_OTLP_ENDPOINT must be set; Load() fails
# otherwise. Disabling makes all instrumentation call sites zero-cost no-ops.
OTEL_ENABLED=false                                                            # optional, default false
OTEL_EXPORTER_OTLP_ENDPOINT=                                                  # REQUIRED IF OTEL_ENABLED=true (e.g. http://otel-collector:4318)
OTEL_SERVICE_NAME=noumena-api                                                 # optional, default noumena-api
OTEL_RESOURCE_ATTRIBUTES=                                                     # optional; comma-separated key=value pairs
